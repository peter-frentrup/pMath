/* pMath Document */

Document({
  SectionGroup({
    SectionGroup({Section("Attributes", "ObjectName"), 
      Section(BoxData(TemplateBox({"Attributes"}, "UsageReference")), 
       "Usage")}, All), SectionGroup({Section("Details", "NotesSection"), 
      SectionGroup({Section("", "NotesSectionHeaderSpacer"), 
        Section(TextData({TemplateBox({"Attributes"}, "ReferenceHyperlink"), 
           " has attribute ", TemplateBox({"HoldFirst"}, 
            "ReferenceHyperlink"), "."}), "Notes"), 
        Section(TextData({TemplateBox({"Attributes"}, "ReferenceHyperlink"), 
           "(\"", StyleBox("name", "Arg"), 
           "\") gives the attributes of a symbol given by name as a \
           string."}), "Notes"), 
        Section(TextData({"The following attributes for a symbol ", 
           StyleBox("sym", "Arg"), " are available:"}), "Notes"), 
        Section(
         TextData({
           GridBox({{{TemplateBox({"Protected"}, "ReferenceHyperlink")}, {
               "assignments to ", StyleBox("sym", "Arg"), " will fail"}}, {
              {TemplateBox({"ReadProtected"}, "ReferenceHyperlink")}, {
               "??", StyleBox("sym", "Arg"), 
               " will not display the value or function definitions for ", 
               StyleBox("sym", "Arg")}}, {
              {TemplateBox({"HoldFirst"}, "ReferenceHyperlink")}, {
               "the first argument ", StyleBox("e", "Arg"), SubscriptBox("1"), 
               " in ", StyleBox("sym", "Arg"), "(", 
               StyleBox({StyleBox("e", "Arg")}, "Arg"), SubscriptBox("1"), 
               ", ", StyleBox({StyleBox("e", "Arg")}, "Arg"), 
               SubscriptBox("2"), 
               ", \[Ellipsis]) will not be evaluated automatically"}}, {
              {TemplateBox({"HoldRest"}, "ReferenceHyperlink")}, {
               "the remaining arguments ", StyleBox("e", "Arg"), 
               SubscriptBox("2"), ", \[Ellipsis] in ", StyleBox("sym", "Arg"), 
               "(", StyleBox({StyleBox("e", "Arg")}, "Arg"), 
               SubscriptBox("1"), ", ", StyleBox({StyleBox("e", "Arg")}, 
                "Arg"), SubscriptBox("2"), 
               ", \[Ellipsis]) will not be evaluated automatically"}}, {
              {TemplateBox({"HoldAll"}, "ReferenceHyperlink")}, {
               "combination of ", TemplateBox({"HoldFirst"}, 
                "ReferenceHyperlink"), " and ", 
               TemplateBox({"HoldRest"}, "ReferenceHyperlink")}}, {
              {TemplateBox({"HoldAllComplete"}, "ReferenceHyperlink")}, {
               "stronger variant of ", TemplateBox({"HoldAll"}, 
                "ReferenceHyperlink"), 
               " in that arguments will not be evaluated even if they have the \
               form ", {TemplateBox({"Evaluate"}, "ReferenceHyperlink"), "(", 
                "\[Ellipsis]", ")"}}}, {
              {TemplateBox({"DeepHoldAll"}, "ReferenceHyperlink")}, {
               "arguments ", StyleBox("e", "Arg"), SubscriptBox("1"), 
               ", \[Ellipsis] in ", StyleBox("sym", "Arg"), "(\[Ellipsis])(", 
               StyleBox({StyleBox("e", "Arg")}, "Arg"), SubscriptBox("1"), 
               ", ", StyleBox({StyleBox("e", "Arg")}, "Arg"), 
               SubscriptBox("2"), 
               ", \[Ellipsis]) will not be evaluated automatically"}}, {
              {TemplateBox({"Listable"}, "ReferenceHyperlink")}, {
               StyleBox("sym", "Arg"), 
               " automatically threads over lists, so that ", 
               StyleBox("sym", "Arg"), "({", StyleBox("a", "Arg"), ", ", 
               StyleBox("b, \[Ellipsis]", "Arg"), "}, {", 
               StyleBox("x", "Arg"), ", ", StyleBox("y", "Arg"), 
               ", \[Ellipsis]}, \[Ellipsis]) gives {", StyleBox("sym", "Arg"), 
               "(", StyleBox("a", "Arg"), ", ", StyleBox("x", "Arg"), 
               ", \[Ellipsis]), ", StyleBox("sym", "Arg"), "(", 
               StyleBox("b", "Arg"), ", ", StyleBox("y", "Arg"), 
               ", \[Ellipsis]), \[Ellipsis]}"}}, {
              {TemplateBox({"Associative"}, "ReferenceHyperlink")}, {
               "an expression ", StyleBox("sym", "Arg"), "(\[Ellipsis], ", 
               StyleBox("sym", "Arg"), "(", 
               StyleBox({StyleBox("", "Arg"), "e"}, "Arg"), SubscriptBox("1"), 
               ", \[Ellipsis], ", StyleBox(StyleBox("e", "Arg"), "Arg"), 
               SubscriptBox("n"), 
               ") , \[Ellipsis]) will be flattened automatially to ", 
               StyleBox("sym", "Arg"), "(\[Ellipsis], ", 
               StyleBox({StyleBox("", "Arg"), "e"}, "Arg"), SubscriptBox("1"), 
               ", \[Ellipsis], ", StyleBox(StyleBox("e", "Arg"), "Arg"), 
               SubscriptBox("n"), ", \[Ellipsis])"}}, {
              {TemplateBox({"OneIdentity"}, "ReferenceHyperlink")}, {
               "expressions ", StyleBox("x", "Arg"), " and ", 
               StyleBox("sym", "Arg"), "(", StyleBox("x", "Arg"), 
               ") are treated as identical during pattern matching"}}, {
              {TemplateBox({"Symmetric"}, "ReferenceHyperlink")}, {
               "an expression ", StyleBox("sym", "Arg"), "(", 
               StyleBox({StyleBox("e", "Arg")}, "Arg"), SubscriptBox("1"), 
               ", ", StyleBox({StyleBox("e", "Arg")}, "Arg"), 
               SubscriptBox("2"), 
               ", \[Ellipsis]) will be sorted automatically and thus ", 
               StyleBox("sym", "Arg"), "(", StyleBox("a", "Arg"), ", ", 
               StyleBox("b", "Arg"), ") = ", StyleBox("sym", "Arg"), "(", 
               StyleBox("b", "Arg"), ", ", StyleBox("a", "Arg"), ")"}}, {
              {TemplateBox({"DefiniteFunction"}, "ReferenceHyperlink")}, {
               "automatically propagate ", TemplateBox({"Undefined"}, 
                "ReferenceHyperlink"), " or ", 
               TemplateBox({"ConditionalExpression"}, "ReferenceHyperlink"), 
               " arguments in ", StyleBox("sym", "Arg"), "(", 
               StyleBox({StyleBox("e", "Arg")}, "Arg"), SubscriptBox("1"), 
               ", ", StyleBox({StyleBox("e", "Arg")}, "Arg"), 
               SubscriptBox("2"), ", \[Ellipsis])"}}, {
              {TemplateBox({"NumericFunction"}, "ReferenceHyperlink")}, {
               "treat ", StyleBox("sym", "Arg"), "(", 
               StyleBox({StyleBox("e", "Arg")}, "Arg"), SubscriptBox("1"), 
               ", ", StyleBox({StyleBox("e", "Arg")}, "Arg"), 
               SubscriptBox("2"), ", \[Ellipsis]) as numeric if all ", 
               StyleBox("e", "Arg"), SubscriptBox(StyleBox("i", "Arg")), 
               " are numeric, see ", TemplateBox({"IsNumeric"}, 
                "ReferenceHyperlink")}}, {
              {TemplateBox({"NHoldFirst"}, "ReferenceHyperlink")}, {
               "the first argument ", StyleBox("e", "Arg"), SubscriptBox("1"), 
               " in ", StyleBox("sym", "Arg"), "(", 
               StyleBox({StyleBox("e", "Arg")}, "Arg"), SubscriptBox("1"), 
               ", ", StyleBox({StyleBox("e", "Arg")}, "Arg"), 
               SubscriptBox("2"), ", \[Ellipsis]) will not be affected by ", 
               TemplateBox({"Numericalize"}, "ReferenceHyperlink"), "(", 
               StyleBox("sym", "Arg"), "(", StyleBox({StyleBox("e", "Arg")}, 
                "Arg"), SubscriptBox("1"), ", ", 
               StyleBox({StyleBox("e", "Arg")}, "Arg"), SubscriptBox("2"), 
               ", \[Ellipsis]))"}}, {
              {TemplateBox({"NHoldRest"}, "ReferenceHyperlink")}, {
               "the remaining arguments ", StyleBox("e", "Arg"), 
               SubscriptBox("2"), ", \[Ellipsis] in ", StyleBox("sym", "Arg"), 
               "(", StyleBox({StyleBox("e", "Arg")}, "Arg"), 
               SubscriptBox("1"), ", ", StyleBox({StyleBox("e", "Arg")}, 
                "Arg"), SubscriptBox("2"), 
               ", \[Ellipsis]) will not be affected by ", 
               TemplateBox({"Numericalize"}, "ReferenceHyperlink"), "(", 
               StyleBox("sym", "Arg"), "(", StyleBox({StyleBox("e", "Arg")}, 
                "Arg"), SubscriptBox("1"), ", ", 
               StyleBox({StyleBox("e", "Arg")}, "Arg"), SubscriptBox("2"), 
               ", \[Ellipsis]))"}}, {
              {TemplateBox({"NHoldAll"}, "ReferenceHyperlink")}, {
               "combination of ", TemplateBox({"NHoldFirst"}, 
                "ReferenceHyperlink"), " and ", 
               TemplateBox({"NHoldRest"}, "ReferenceHyperlink")}}, {
              {TemplateBox({"SequenceHold"}, "ReferenceHyperlink")}, {
               TemplateBox({"Sequence"}, "ReferenceHyperlink"), 
               "(\[Ellipsis]) will not be sliced when it appears as an \
               argument in ", StyleBox("sym", "Arg"), "(\[Ellipsis])"}}, {
              {TemplateBox({"Temporary"}, "ReferenceHyperlink")}, {
               "memory for the symbol ", StyleBox("sym", "Arg"), 
               " will be released immeditely when it is no longer directly \
               referenced"}}, {
              {TemplateBox({"ThreadLocal"}, "ReferenceHyperlink")}, {
               "values assigned to ", StyleBox("sym", "Arg"), 
               " are local to the current execution thread"}}, {
              {TemplateBox({"Removed"}, "ReferenceHyperlink")}, 
              "the symbol was removed from the global symbol table but there \
              are pending references to it"}})}), "2ColumnTableNotes"), 
        Section(TextData({TemplateBox({"Attributes"}, "ReferenceHyperlink"), 
           " automatically threads over lists."}), "Notes")}, All), 
      Section("", "SectionFooterSpacer")}, 1), 
    SectionGroup({Section("Examples", "PrimaryExamplesSection"), 
