            {{"Attributes", "(", "g", ")"}, "\[Assign]", "Listable"}, ";"})), 
         "Input", SectionLabel -> "in [1]:"), 
        Section(
         TextData({TemplateBox({"SetAttributes"}, "ReferenceHyperlink"), 
