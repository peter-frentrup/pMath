            Section(BoxData({"{", {"DefiniteFunction", ",", "Listable", ",", 
                "NumericFunction", ",", "Protected", ",", "ReadProtected"}, 
               "}"}), "Output", SectionGenerated -> True, 
             SectionLabel -> "out [1]:")}, All)}, All)}, 1), 
      SectionGroup({Section("Properties & Relations", "ExampleSection"), 
        Section(TextData({"Assign a single attribute to the symbols ", 
