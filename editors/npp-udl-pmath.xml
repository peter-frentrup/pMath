<!--  (evaluation as inline tests disabled, because collecting  allOptions  and  allWithUsage  is slow)
pmat h> all:=              Sort(Names("System`*"));
pmat h> allFunc:=          all.Select(Function(Developer`HasBuiltinCode(#, {DownRules, SubRules}) || DownRules(#)=!={} || SubRules(#)=!={}));
pmat h> allRest:=          Complement(all, allFunc);
pmat h> allUnknown:=       allRest.Select(Function(OwnRules(#).Match({(Rule|RuleDelayed)(~, ~:System`Private`AutoLoadStart)})));
pmat h> allRest:=          Complement(allRest, allUnknown);
pmat h> allValues:=        allRest.Select(Function(OwnRules(#) =!= {}));
pmat h> allRest:=          Complement(allRest, allValues);
pmat h> allOptions:=       Union @@ (Complement(all, allValues) |> Map(Function(Options(#)[All, 1] |> Map(Function(ToString(LongForm(#)))))));
pmat h> allRest:=          Complement(allRest, allOptions);
pmat h> allWithUsage:=     all.Select(Function(ToExpression({#, "::", "usage"}).IsString));
pmat h> allConstSymbolic:= allRest.Select(Function(Attributes(#) === {Protected} && SyntaxInformation(#) === /\/));
-->
<Keywords name='Keywords2' gen='
pmat h> Print("\[RawQuote]>"); Do(Print(StringReplace(s, StartOfString ++ "System`" -> "")), s->Intersection(allConstSymbolic, allWithUsage))
